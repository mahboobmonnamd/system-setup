# Brewfile.personal — extras for personal machines only.
# (colima and the k8s stack live in base — same tooling on work and personal)
cask "brave-browser"
cask "bitwarden"
cask "obsidian"
cask "visual-studio-code"   # fallback editor during the terminal transition
cask "cursor"
cask "appcleaner"
cask "claude"
cask "claude-code"

# Manual per-click browser picker. Third-party PERSONAL tap — Homebrew won't
# load it until trusted once (supply-chain opt-in):
#   brew trust --cask alexstrnik/browserino/browserino
# then `make brew` (or the lines below on a fresh personal bootstrap).
tap "alexstrnik/browserino"
cask "alexstrnik/browserino/browserino"
