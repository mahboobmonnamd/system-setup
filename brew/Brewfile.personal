# Brewfile.personal — extras for personal machines only.
#
# PDP compute runtime (ADR-105): OrbStack is the authorized Platform Runtime on
# the personal/home primary compute host. Work machines use Colima instead
# (see Brewfile.work) because base/work must stay open-source / enterprise-safe.
cask "orbstack"     # container VM + Docker-compatible engine (PDP ADR-105 / ADR-106)

cask "brave-browser"
cask "bitwarden"
cask "obsidian"
cask "visual-studio-code"   # fallback editor during the terminal transition
cask "cursor"
cask "appcleaner"
cask "claude"
cask "claude-code"
cask "discord"
cask "google-drive"
cask "utm"          # virtual machines (QEMU frontend)
cask "chatgpt"
cask "google-chrome"
cask "android-studio"
cask "ollama-app"   # local LLM runner (Ollama.app)
cask "openclaw"     # personal AI assistant (menu bar companion)

# Manual per-click browser picker. Third-party PERSONAL tap — `trusted: true`
# opts into Homebrew 6 tap-trust for this cask only (not the whole tap).
tap "alexstrnik/browserino"
cask "alexstrnik/browserino/browserino", trusted: true
