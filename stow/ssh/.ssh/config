# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# SSH config — PUBLIC (committed). Machine-local hosts/secrets go in
# ~/.ssh/config.local (gitignored), pulled in by the Include below.
#
# Colima SSH (work profile only): add to ~/.ssh/config.local if needed:
#   Include ~/.colima/ssh_config
#
# One host alias per git account: same real host (github.com), different key.
# The alias you clone with decides which key — and via .gitconfig includeIf,
# which name/email — a repo uses:
#   git clone git@github.com:you/repo.git          -> personal
#   git clone git@github.com-work:org/repo.git     -> work

Include ~/.ssh/config.local

# Personal GitHub (default host)
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

# Work GitHub
Host github.com-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_work
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

# Freelance GitHub
Host github.com-freelance
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_freelance
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

# Open-source GitHub
Host github.com-oss
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_oss
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes
