# SSH config — PUBLIC (committed). Keep secrets/hostnames you don't want public
# in ~/.ssh/config.local (gitignored), pulled in by the Include below.
#
# One host alias per git account. Same real host (github.com), different keys.
# Clone with the alias to bind a repo to an account, e.g.:
#   git clone git@github.com:you/repo.git            # personal (default host)
#   git clone git@github.com-work:org/repo.git       # work
#
# Note: the per-directory git identity (name/email + key via core.sshCommand)
# is set in ~/.config/git/identity-*.gitconfig. These SSH aliases mainly matter
# when two accounts share a host and you can't tell them apart by key otherwise.

Include ~/.ssh/config.local

# Personal GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

# Work GitHub
Host github.com-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_work
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

# Freelance GitHub
Host github.com-freelance
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_freelance
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

# Open-source GitHub
Host github.com-oss
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_oss
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes
