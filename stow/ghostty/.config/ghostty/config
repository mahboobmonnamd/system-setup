# Ghostty — the terminal. Docs: https://ghostty.org/docs/config
# Validate after editing with:  ghostty +show-config

# --- Look & feel ------------------------------------------------------------
theme = Catppuccin Latte
font-family = JetBrainsMono Nerd Font
font-size = 16
# cmux chrome (read by cmux from this Ghostty config; capped at 14pt for the
# surface tab bar). Stock Ghostty ignores unknown keys on some builds — if
# `ghostty +show-config` errors, comment these two lines out for plain Ghostty.
surface-tab-bar-font-size = 14
sidebar-font-size = 14
# Overlay1 from Catppuccin Latte — visible split lines on the light theme
split-divider-color = #5c5f77
window-padding-x = 8
window-padding-y = 8

# Slight frosted-glass effect. Set opacity to 1 for a fully solid window.
background-opacity = 0.95
background-blur-radius = 20

# --- Behavior ---------------------------------------------------------------
# New windows/tabs open here. `inherit` (default) would reuse the parent's dir;
# a fixed path makes every fresh window start in ~/Developer.
working-directory = ~/Developer
# Option acts as Alt (needed for Alt-C fzf directory search and word-jumps)
macos-option-as-alt = true
mouse-hide-while-typing = true
# Sane scrollback
scrollback-limit = 100000

# Shell integration: Ghostty marks each prompt, so Cmd+Up/Down jumps between
# commands and closing a window with a running job asks first.
shell-integration = zsh

# --- Quake-style dropdown terminal ------------------------------------------
# Cmd+Opt+` from ANYWHERE slides a terminal down from the top of the screen.
# Same key hides it. (Plain Cmd+` is left alone — macOS uses it to cycle
# windows of the frontmost app.)
keybind = global:cmd+alt+grave_accent=toggle_quick_terminal
